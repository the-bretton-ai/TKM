# Safe mode. Set true to disable provider calls even when credentials exist.
TOKEN_FLEXER_DEMO=true

# Server-only owner authorization. Generate a long random value.
TOKEN_FLEXER_SEND_KEY=

# Server-only JSON allowlist. Never commit real values.
# Example shape: [{"alias":"friend-one","email":"name@example.com","displayName":"Friend","consent":true}]
TOKEN_FLEXER_RECIPIENTS=[]

# Server-only signing key for unsubscribe links.
TOKEN_FLEXER_SIGNING_SECRET=

# Transactional email provider.
EMAIL_API_KEY=
EMAIL_FROM=

# Canonical HTTPS deployment origin, without a trailing slash.
APP_ORIGIN=http://localhost:8888
